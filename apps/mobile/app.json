{
  "expo": {
    "name": "SixFinger",
    "slug": "sixfinger",
    "scheme": "sixfinger",
    "version": "0.11.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#0b0b0c",
    "icon": "./assets/icon.png",
    "newArchEnabled": true,
    "android": {
      "package": "live.sixfinger.chat",
      "versionCode": 36,
      "softwareKeyboardLayoutMode": "resize",
      "predictiveBackGestureEnabled": false,
      "adaptiveIcon": {
        "backgroundColor": "#0b0b0c",
        "foregroundImage": "./assets/adaptive-foreground.png",
        "monochromeImage": "./assets/adaptive-foreground.png"
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-localization",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0b0b0c",
          "image": "./assets/splash-icon.png",
          "imageWidth": 140
        }
      ],
      "expo-font",
      "expo-status-bar",
      "expo-sharing",
      "./plugins/withReleaseSigning"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    }
  }
}