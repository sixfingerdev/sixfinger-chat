<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- SixFinger: her zaman koyu zemin; açık tema web içinde yönetilir. -->
    <style name="AppTheme" parent="Theme.AppCompat.NoActionBar">
        <item name="colorPrimary">#0b0b0c</item>
        <item name="colorPrimaryDark">#0b0b0c</item>
        <item name="colorAccent">#ff6a1a</item>
        <item name="android:windowBackground">#0b0b0c</item>
        <item name="android:statusBarColor">#0b0b0c</item>
        <item name="android:navigationBarColor">#0b0b0c</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="AppTheme">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
    </style>
</resources>
