# --- Sunucu ---
PORT=8787
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info
# Web arayüzünün yayınlandığı adres(ler), virgülle ayır. Android uygulaması için capacitor://localhost ve https://localhost ekli gelir.
CORS_ORIGINS=http://localhost:5173
# E-postadaki bağlantılar ve paylaşım adresleri için herkese açık web adresi
PUBLIC_WEB_URL=http://localhost:5173
# Derlenmiş web arayüzünü sunucunun kendisi yayınlasın (tek servis). Docker imajında /app/web.
# WEB_DIST=../web/dist
# Reverse proxy (Render, Fly, nginx...) arkasındaysan true
TRUST_PROXY=false

# --- Veritabanı (Postgres 14+) ---
DATABASE_URL=postgres://sixfinger:sixfinger@127.0.0.1:5432/sixfinger
# Yönetilen Postgres (Supabase vb.) için: DATABASE_SSL=true
DATABASE_SSL=false

# --- Kimlik doğrulama ---
# En az 32 karakter, rastgele. Üretmek için: openssl rand -base64 48
JWT_SECRET=change-me-change-me-change-me-change-me
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=60

# --- Yapay zekâ sağlayıcısı (Pollinations) ---
AI_BASE_URL=https://text.pollinations.ai/openai
AI_MODEL=openai-fast
# Opsiyonel: gen.pollinations.ai anahtarı (sk_...). Anonim kota yetmezse kullan.
AI_API_KEY=
# Pollinations anonim katmanı IP başına kısa bekleme uygular; düşük tutmak güvenlidir.
AI_MAX_CONCURRENCY=2
AI_TIMEOUT_MS=120000

# --- SMTP (e-posta doğrulama / şifre sıfırlama) ---
# Boş bırakılırsa kodlar sunucu loguna yazılır (sadece geliştirme için).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="SixFinger <no-reply@example.com>"
SMTP_SECURE=false

# --- SixFinger Code (docs/code.md) ---
# GitHub > Settings > Developer settings > OAuth Apps. Callback: <PUBLIC_WEB_URL>/api/code/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# openssl rand -base64 48   (JWT_SECRET'tan ayrı; değiştirirsen kayıtlı GitHub bağlantıları çözülemez)
CODE_SECRET_KEY=
# Code kullanabilen e-postalar (virgülle) ya da herkese açmak için *
CODE_ALLOWED_EMAILS=
CODE_DAILY_CREDITS=100
CODE_CLAUDE_DAILY_TOKENS=2000000
# Aynı anda çalışan Code oturumu (Pi 4: 2), bekleme sırası, bağlam bütçesi (token)
CODE_MAX_RUNS=2
CODE_MAX_QUEUE=10
CODE_CONTEXT_TOKENS=262144
# Bağlam bu orana dolunca eski konuşma modele özetlettirilir (önce eski araç çıktıları kırpılır).
CODE_COMPACT_AT=0.8

# --- MCP bağlayıcıları (docs/mcp.md) ---
# CODE_SECRET_KEY tanımlıysa açıktır (anahtarlar/jetonlar onunla şifrelenir). Kapatmak için false.
MCP_ENABLED=true
# Dinamik istemci kaydı OLMAYAN OAuth sağlayıcıları için yönetici istemcileri (boşsa o kartlar pasif):
# Geri dönüş adresi her sağlayıcıda  PUBLIC_WEB_URL/api/mcp/oauth/callback  olmalı.
MCP_GOOGLE_CLIENT_ID=
MCP_GOOGLE_CLIENT_SECRET=
MCP_SLACK_CLIENT_ID=
MCP_SLACK_CLIENT_SECRET=
MCP_HUBSPOT_CLIENT_ID=
MCP_HUBSPOT_CLIENT_SECRET=
MCP_BOX_CLIENT_ID=
MCP_BOX_CLIENT_SECRET=

# Ücretsiz sağlayıcılar (anahtarsız da çalışır): DeepSeek, GLM (LLM7) ve MiniMax (Kilo). Mod sıraları README'de. Kapatmak için AI_FREE_ENABLED=false.
# LLM7_API_KEY isteğe bağlı: reddedilirse (401/402/403) anahtarsız denenir.
AI_FREE_ENABLED=true
# true (varsayılan): Code'da model seçimi çalışır. Hızlı: MiniMax -> DeepSeek -> GLM -> Qwen -> Claude, Derin: DeepSeek -> GLM -> Qwen -> Claude.
# false: ikisi de Qwen -> Claude (depo içeriği üçüncü taraf ücretsiz servislere gitmez)
AI_FREE_FOR_CODE=true

# Web arama: kendi sunucundaki SearXNG (docker-compose'ta `searxng` servisi); boş bırakılırsa DuckDuckGo + Bing birlikte kullanılır
SEARXNG_URL=http://searxng:8080
LLM7_API_KEY=
KILO_API_KEY=
# llmtr.com (ücretsiz modeller; anahtar gerekir, boşsa kapalı): Qwen 3.8'in yedeği ve Nemotron 3.5 Super VL. Yeni hesaplarda günlük ücretsiz kota düşüktür.
LLMTR_API_KEY=
# reasoning_effort destekleyen modellere en yüksek düzey gider (gpt-oss: high, ücretsiz modeller: max); false: kullanıcının düşünme düzeyi
AI_MAX_EFFORT=true

# Code commit'lerinin ortak yazarı (Contributors'ta görünmesi için e-posta bir GitHub hesabına bağlı olmalı; docs/code.md). Boşsa: SixFinger Code <noreply@sixfinger.live>
CODE_COAUTHOR=
