{
  "name": "@sixfinger/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "build": "tsup",
    "migrate": "tsx --env-file-if-exists=.env src/db/migrate-cli.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "mock-ai": "node scripts/mock-ai.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1152.0",
    "@fastify/cors": "^10.0.2",
    "@fastify/helmet": "^13.0.0",
    "@fastify/rate-limit": "^10.2.2",
    "@fastify/static": "^8.3.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@mozilla/readability": "^0.6.0",
    "@sixfinger/shared": "*",
    "cheerio": "^1.2.0",
    "fastify": "^5.2.0",
    "jose": "^5.9.6",
    "linkedom": "^0.18.13",
    "nodemailer": "^6.9.16",
    "pg": "^8.13.1",
    "turndown": "^7.2.4",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/nodemailer": "^6.4.17",
    "@types/pg": "^8.11.10",
    "@types/turndown": "^5.0.6",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "vitest": "^3.0.5"
  }
}
